{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [],
  "DevMinPlayers": 0,
  "WebBuildPath": "../../Builds/Web",
  "MaxConnectionsPerIp": 10,
  "ClientIpHeader": "",
  "MaxMessageBytes": 8192,
  "TickMs": 200,
  "EmptyRoomMinutes": 15,
  "MessagesPerSecond": 20,
  "ChatPerSecond": 1,
  "ReactionsPerSecond": 2
}
