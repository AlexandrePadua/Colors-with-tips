# syntax=docker/dockerfile:1
# GENERATED by Tools/Deploy/publish_deploy_branch.py — edit Server/Dockerfile and the script, not this file.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Server/Pitacor.Core/Pitacor.Core.csproj Server/Pitacor.Core/
COPY Server/Pitacor.Server/Pitacor.Server.csproj Server/Pitacor.Server/
RUN dotnet restore Server/Pitacor.Server/Pitacor.Server.csproj
COPY Assets/Pitacor/Core/ Assets/Pitacor/Core/
COPY Server/Pitacor.Core/ Server/Pitacor.Core/
COPY Server/Pitacor.Server/ Server/Pitacor.Server/
RUN dotnet publish Server/Pitacor.Server/Pitacor.Server.csproj -c Release -o /app --no-restore -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
# The Unity Web build, served at "/" by the same server (invite links: https://<host>/?sala=CODE).
COPY web/ /app/web/
# Render passes PORT; behind its proxy every socket comes from the proxy, so the per-IP limit reads the client
# address from the header Cloudflare (in front of Render) overwrites, falling back to X-Forwarded-For.
ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_gcServer=0 \
    WebBuildPath=/app/web \
    ClientIpHeader=CF-Connecting-IP,X-Forwarded-For
EXPOSE 10000
USER $APP_UID
ENTRYPOINT ["dotnet", "Pitacor.Server.dll"]
